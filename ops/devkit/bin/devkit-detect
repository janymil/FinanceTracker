#!/usr/bin/env bash
# devkit-detect — print an app's .devkit/profile.sh on stdout.
#
# Read-only: it never writes into the app. The caller decides where the profile goes.
# Usage: devkit-detect /var/www/kaptia
#
# A step is "name|command|tag", where tag is:
#   gate — runs on every ./verify.sh
#   slow — only with ./verify.sh --all (builds, end-to-end suites)
#
# Nothing here guesses a watch-mode command. CI=1 is exported by verify.sh and every
# runner below is an explicit "run once" invocation, because a gate that hangs waiting
# for a keypress is worse than no gate.
set -uo pipefail

app="${1:-.}"
app="$(cd "$app" 2>/dev/null && pwd)" || {
  echo "devkit-detect: no such directory: ${1:-}" >&2
  exit 1
}
name="$(basename "$app")"

# --- helpers -----------------------------------------------------------------

has_script() {
  [ -f "$app/package.json" ] || return 1
  DEVKIT_PKG="$app/package.json" DEVKIT_SCRIPT="$1" node -e '
    let pkg;
    try { pkg = require(process.env.DEVKIT_PKG); } catch { process.exit(1); }
    const scripts = pkg.scripts || {};
    process.exit(Object.prototype.hasOwnProperty.call(scripts, process.env.DEVKIT_SCRIPT) ? 0 : 1);
  ' 2>/dev/null
}

script_value() {
  DEVKIT_PKG="$app/package.json" DEVKIT_SCRIPT="$1" node -e '
    const pkg = require(process.env.DEVKIT_PKG);
    process.stdout.write(String((pkg.scripts || {})[process.env.DEVKIT_SCRIPT] || ""));
  ' 2>/dev/null
}

steps=()
add_step() { steps+=("$1|$2|$3"); }

# --- node --------------------------------------------------------------------

if [ -f "$app/package.json" ]; then
  stack="node"
  pm="npm"
  [ -f "$app/pnpm-lock.yaml" ] && pm="pnpm"
  [ -f "$app/yarn.lock" ] && pm="yarn"
  [ -f "$app/package-lock.json" ] && pm="npm"

  # Types/invariants first: cheapest signal, and it fails fastest.
  if has_script check; then
    add_step "checks" "$pm run check" gate
  elif [ -f "$app/tsconfig.json" ]; then
    add_step "typecheck" "npx --no-install tsc --noEmit" gate
  fi

  # Tests: prefer the real runner binary when it is installed, so the command does not
  # depend on what the app's `test` script happens to do.
  if [ -x "$app/node_modules/.bin/vitest" ]; then
    add_step "tests" "./node_modules/.bin/vitest run" gate
  elif [ -x "$app/node_modules/.bin/jest" ]; then
    add_step "tests" "./node_modules/.bin/jest --ci" gate
  elif has_script test; then
    add_step "tests" "$pm run test" gate
  fi

  # The code map, kept honest after every change (only when the app already uses it).
  if [ -d "$app/graphify-out" ] && command -v graphify >/dev/null 2>&1; then
    add_step "graph" "graphify update ." gate
  fi

  if has_script build; then
    add_step "build" "$pm run build" slow
  fi

elif [ -f "$app/pyproject.toml" ] || [ -f "$app/requirements.txt" ]; then
  stack="python"
  if grep -q '\[tool.ruff' "$app/pyproject.toml" 2>/dev/null; then
    add_step "lint" "python3 -m ruff check ." gate
  fi
  if [ -d "$app/tests" ] || [ -d "$app/test" ] || compgen -G "$app/test_*.py" >/dev/null 2>&1; then
    add_step "tests" "python3 -m pytest -q" gate
  fi

else
  stack="unknown"
fi

# --- output ------------------------------------------------------------------

echo "# Generated by devkit-detect on $(date -Iseconds) for $app"
echo "# Edit this file to change the gate. It is yours once it exists — devkit never overwrites it."
echo "DEVKIT_APP_NAME='$name'"
echo "DEVKIT_STACK='$stack'"
echo "DEVKIT_PM='${pm:-none}'"

if [ "${#steps[@]}" -eq 0 ]; then
  echo "# No steps were detected. Add the app's own commands here, for example:"
  echo "# DEVKIT_STEPS=('tests|make test|gate')"
  echo "DEVKIT_STEPS=()"
else
  echo "DEVKIT_STEPS=("
  for step in "${steps[@]}"; do
    echo "  '$step'"
  done
  echo ")"
fi
