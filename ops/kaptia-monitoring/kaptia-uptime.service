[Unit]
Description=Kaptia external uptime check (API, database, public page)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/kaptia
Environment=NODE_ENV=production
ExecStart=/var/www/kaptia/node_modules/.bin/tsx scripts/uptime-check.ts
StandardOutput=append:/var/log/kaptia-uptime.log
StandardError=append:/var/log/kaptia-uptime.log
NoNewPrivileges=true
# A runaway job must never eat the server: hard caps, and a start timeout so a
# hung script is killed instead of piling up.
TimeoutStartSec=180
MemoryMax=256M
CPUQuota=50%
