# ─────────────────────────────────────────────────────────────────────────────
# Kaptia environment TEMPLATE. Committed. Contains dummies only - no real values.
#
# `cp .env.example .env` and fill in the real values. Every variable the code reads
# is listed here, so this file is the contract: an AI agent can learn everything it
# needs from it and never has a reason to open the real `.env`.
#
# That is the *convenience* half. The *enforcement* half is the deny list in
# `.claude/settings.json` (Read(./.env)) plus, for shell commands, the OS sandbox -
# see docs/secrets-policy.md. An example file alone blocks nothing.
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database
# Production database (Neon). Used by server/db.ts when NODE_ENV=production, by
# `npm run db:clean-users:prod`, `db:migrate:prod` and `db:drift:prod`.
DATABASE_URL_PROD=postgresql://user:password@ep-xxx.neon.tech/neondb
# Ceiling for a single SQL statement, in milliseconds (default 30000). Read by server/db.ts.
# Raise it only if a bulk statement import or account export is being cut off.
DB_STATEMENT_TIMEOUT_MS=30000
# A RESTORED copy of the database, used only by `npm run dr:verify`
# (scripts/restore-verify.ts) during the recovery drill in docs/recovery-runbook.md.
# Never point this at production: the script refuses DATABASE_URL_PROD and this is the
# copy you are allowed to break.
RESTORE_DATABASE_URL=postgresql://user:password@ep-restored-branch.neon.tech/neondb

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL. Used for e-mail links (reminders, goals, complaints),
# MercadoPago back_urls and Stripe redirects. No trailing slash.
APP_URL=https://kaptia.example.com

# Clerk Authentication
# IMPORTANT: CLERK_SECRET_KEY must be a SECRET key (sk_test_... / sk_live_...).
# Using the publishable key here makes every authenticated API request return 401.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Production Clerk secret key (sk_live_...), used by `npm run auth:clean-users:prod`.
CLERK_SECRET_KEY_PROD=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# OpenAI
OPENAI_API_KEY=sk-proj-...

# AI routing (lib/aiProvider.ts)
# gpt-6-luna is the default model for every task. Fallbacks: DeepSeek, then Groq.
# reasoning effort: none | minimal | low | medium  (none = cheapest/fastest)
AI_REASONING_EFFORT=none
AI_REQUEST_TIMEOUT_MS=90000

# AI gateway (the ai-processor repo: one service for all your apps, keeps the provider keys)
# Every AI call goes to the gateway first; if it is off, slow or refuses, the app calls the
# providers directly (OpenAI, then DeepSeek, then Groq). The gateway is only used when it is
# enabled AND has a URL AND a key - a gateway without a key is never called.
AI_PROCESSOR_ENABLED=false
AI_PROCESSOR_URL=https://ai-processor.formatika.dev
AI_PROCESSOR_API_KEY=
# 45s default; bank statements get at least 120s. A call the app gives up on is cancelled upstream.
AI_PROCESSOR_TIMEOUT_MS=45000

# Circuit breaker + budget for the direct providers (and the gateway): three failures in a row
# skip a provider for a minute; one request never spends longer than the total budget.
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000
AI_TOTAL_BUDGET_MS=120000

# Per-person ceiling on AI calls (counted by user id, never by IP)
AI_RATE_PER_MIN=20
AI_RATE_PER_HOUR=300

# PDF Report Processor (standalone app on pdf-processor.formatika.dev)
# Used by /api/export-pdf, /api/export (format: pdf) and /api/generate-trends-pdf.
PDF_SERVICE_URL=https://pdf-processor.formatika.dev
PDF_API_KEY=
PDF_SERVICE_TIMEOUT_MS=60000

# Mistral / Groq (voice, OCR, AI fallbacks)
MISTRAL_API_KEY=
GROQ_API_KEY=
# Direct DeepSeek fallback. Route in lib/aiProvider.ts is:
# gateway -> OpenAI -> DeepSeek -> Groq.
DEEPSEEK_API_KEY=
# Mistral OCR model (mistral-ocr-latest, mistral-ocr-4-1, ...)
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Cloudflare R2 (receipts, exports, backups) - falls back to local disk when empty
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Database dumps (read by scripts/db-dump.ts, run daily by ops/kaptia-monitoring/kaptia-db-dump.timer)
# The destination must NOT be the provider that holds the database: a copy next to the original
# is not a second copy. Any S3-compatible bucket works; leave the bucket empty to use BACKUP_DIR.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Alternative destination when there is no bucket: a directory on a different mount.
BACKUP_DIR=
# How many days of dumps to keep. Must cover the longest outage you would tolerate.
BACKUP_RETAIN_DAYS=30

# Admin Panel
# Legacy shared password for /admin-analytics and /admin-watch (read by server/adminAuth.ts).
# Preferred path: give the person a Clerk account whose public metadata has role="admin";
# that needs no variable here and works with Clerk MFA. Remove ADMIN_PASSWORD once every
# admin signs in through Clerk.
ADMIN_PASSWORD=your_admin_password
# Second factor for the Clerk admin path (read by server/adminAuth.ts).
# auto (default) = required in production, not required elsewhere; 1 = always; 0 = never.
# The shared ADMIN_PASSWORD above cannot be protected this way — remove it once everyone is on Clerk.
ADMIN_REQUIRE_2FA=auto

# Session Secret
SESSION_SECRET=your_session_secret

# ── Field-level encryption (server/encryption.ts) ───────────────────────────
# Exactly 64 hex characters (32 bytes). Production throws on startup if this is
# missing or malformed, and anything written with a different key becomes
# unreadable - never change it in place without re-encrypting the affected
# columns first (see server/encryptionDiagnostics.ts).
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# true = also encrypt outside production (production always encrypts).
ENCRYPTION_ENABLED=false

# Stripe
# Both `price_…` ids and `prod_…` product ids are accepted. Product ids are
# resolved to the product's default_price via the Stripe API (cached in memory).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One price per plan, interval AND currency. The page language chooses the currency:
# es -> PEN (soles), everything else -> USD. Keep these aligned with shared/pricing.ts.
STRIPE_STANDARD_MONTHLY_USD_PRICE_ID=price_...
STRIPE_STANDARD_YEARLY_USD_PRICE_ID=price_...
STRIPE_PREMIUM_MONTHLY_USD_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_USD_PRICE_ID=price_...
STRIPE_STANDARD_MONTHLY_PEN_PRICE_ID=price_...
STRIPE_STANDARD_YEARLY_PEN_PRICE_ID=price_...
STRIPE_PREMIUM_MONTHLY_PEN_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_PEN_PRICE_ID=price_...

# Analytics (optional). Without these the app simply does not load gtag.
# Nothing is loaded before the visitor accepts analytics in the cookie banner.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
# Base URL of the landing-page videos (defaults to https://media.kaptia.app/videos).
VITE_MEDIA_BASE_URL=https://media.kaptia.app/videos

# Google Cloud Vision (for OCR)
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_PRIVATE_KEY_ID=your_key_id
GOOGLE_CLOUD_PRIVATE_KEY=your_private_key
GOOGLE_CLOUD_CLIENT_EMAIL=your_service_account_email
GOOGLE_CLOUD_CLIENT_ID=your_client_id
GOOGLE_CLOUD_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_CLOUD_TOKEN_URI=https://oauth2.googleapis.com/token
# Alternative to the GOOGLE_CLOUD_* values above: path to a service-account JSON
# on disk (server/ocr.ts). Never commit the real file - .gitignore already
# blocks service-account.json / *-service-account.json / gcp-*.json.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.example.json

# Bunny.net Cloud Storage
BUNNY_STORAGE_ZONE=your_storage_zone
BUNNY_ACCESS_KEY=your_access_key
BUNNY_STORAGE_PASSWORD=your_storage_password
# Public pull-zone host used to build asset URLs (defaults to <zone>.b-cdn.net).
BUNNY_PULLZONE_URL=https://kaptia.b-cdn.net
BUNNY_CDN_URL=https://kaptia.b-cdn.net

# ── E-mail (server/emailService.ts, server/contact.ts, Error Guard alerts) ──
# SendGrid wins when its key is set; otherwise SMTP is used when HOST + USER +
# PASS are all present. With neither, e-mail is disabled and the app keeps working.
SENDGRID_API_KEY=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@example.com
EMAIL_PASS=your_smtp_password
# Default From address (falls back to EMAIL_USER, then no-reply@kaptia.app).
EMAIL_FROM=no-reply@example.com
# Contact-form copy recipient and fallback recipient for Error Guard alerts.
EMAIL_TO=support@example.com
# Zoho mailbox app password. NOTE: no code reads this today (legacy) - confirm in
# ops/ before relying on it.
ZOHO_APP_PASSWORD=your_zoho_app_password

# ── Observability ───────────────────────────────────────────────────────────
# There is no Sentry in this project. All error reporting is the in-house
# Error Guard (see /sk/admin-watch and the ERROR_GUARD_* block below).
# Release identifier shown on every problem card (optional but recommended).
VITE_APP_RELEASE=

# ── Synthetic monitoring (scripts/healthcheck.ts) ───────────────────────────
# GET /api/health (shallow) or /api/health/deep (also pings the database with SELECT 1).
HEALTHCHECK_URL=https://kaptia.app
HEALTHCHECK_MAX_LATENCY_MS=2000
# scripts/uptime-check.ts (falls back to HEALTHCHECK_URL, then ERROR_GUARD_URL).
UPTIME_BASE_URL=https://kaptia.app
UPTIME_TIMEOUT_MS=10000
# Escape hatch for E2E only. Ignored when NODE_ENV=production.
DISABLE_COUNTRY_BLOCKING=0
# What happens when the answer is unknown (server/middleware/countryBlocking.ts).
# With the blocked-country list unreadable the request is refused (503) — "we cannot tell who is
# blocked" is not "nobody is blocked". Set to 1 to prefer availability over that rule.
COUNTRY_BLOCK_FAIL_OPEN=0
# A failed geolocation lookup is allowed by default: turning a third-party outage into our own
# outage is worse than the compliance risk. Set to 1 to refuse those requests too.
COUNTRY_BLOCK_GEO_FAIL_CLOSED=0

# ── E2E (Playwright) ────────────────────────────────────────────────────────
# Opt-in: without E2E_ENABLED=1 every spec skips with an explicit reason.
E2E_ENABLED=0
E2E_BASE_URL=http://localhost:5000
E2E_LOCALE=sk
# Clerk test user for tests/e2e/auth.setup.ts. The values below are the shared
# public test account and are safe as defaults; override for your own branch.
E2E_USER_EMAIL=kaptia.e2e+clerk_test@example.com
E2E_USER_PASSWORD=KaptiaE2E!2026
# Local stub that replaces pdf-processor.formatika.dev during E2E.
E2E_PDF_STUB_PORT=4010
# Let Playwright start the app itself (uses the vars above + .env).
E2E_MANAGED_SERVER=0

# ── Integration tests (disposable database, never production) ───────────────
# Read by tests/integration/dbTestEnv.ts and `npm run db:migrate:test`. Keep the real value
# in `.env.test` (git-ignored); scripts/deploy.sh applies the migration files to this
# database and runs the suite against it before every release.
DATABASE_URL_TEST=

# ── Error Guard (blueprint 07, /sk/admin-watch) ─────────────────────────────
# All optional: the guard runs with sane defaults and degrades to "no AI" without keys.
# How often the in-memory buffer is written to Postgres (default 10 s).
ERROR_GUARD_FLUSH_MS=10000
# Per-IP requests per minute on the public ingest endpoint (default 240).
ERROR_GUARD_INTAKE_PER_MINUTE=240
# AI explanations per UTC day (default 25). Set to 0 to never call AI.
ERROR_GUARD_AI_BUDGET=25
# `off` disables AI explanations; the problem list keeps working. Anything else = on.
ERROR_GUARD_AI=on
ERROR_GUARD_AI_TIMEOUT_MS=20000
# After a failed triage call, stop asking for 5 minutes (never blocks a request).
ERROR_GUARD_AI_COOLDOWN_MS=300000
# `off` disables server-side reporting (reportSwallowed / reportInvariant) entirely.
ERROR_GUARD_SERVER=on
# Triage goes to AI_PROCESSOR_URL + /error-triage (see the AI processor block above).
# E-mail alerts: comma-separated recipients. Empty = no alerts, the screen still works.
ERROR_GUARD_ALERT_EMAIL=
# Base URL used in the alert e-mail link (defaults to APP_URL or https://kaptia.app).
ERROR_GUARD_URL=
# Alert throttling: at most one e-mail per 10 min, 8 per day, once per problem per 6 h.
ERROR_GUARD_ALERT_MIN_GAP_MS=600000
ERROR_GUARD_ALERT_MAX_PER_DAY=8
# Same problem already alerted within this window -> no second e-mail (default 6 h).
ERROR_GUARD_ALERT_GROUP_GAP_MS=21600000

# ── Error Guard (browser) ───────────────────────────────────────────────────
# `off` disables client-side capture entirely (capture is on by default).
# VITE_ERROR_GUARD=off

# ── MercadoPago — subscriptions paid in Peruvian soles (es pages) ───────────
# Without MERCADOPAGO_ACCESS_TOKEN the PEN checkout answers 503 and Stripe keeps working.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Webhook signing secret from the MercadoPago dashboard (x-signature).
MERCADOPAGO_WEBHOOK_SECRET=

# ── Receipt extraction (server/receiptExtraction.ts) ────────────────────────
# 1 = allow the regex-only fallback when the AI is unavailable. Off by default,
# because a regex over OCR text returns garbage more often than not.
RECEIPT_REGEX_FALLBACK=0

# ── Listen address (server/index.ts) ────────────────────────────────────────
# Empty = bind every interface, which a host that publishes the port itself needs.
# This machine runs with HOST=127.0.0.1 (set in ecosystem.config.cjs), because the
# reverse proxy is the only intended way in. `npm start` alone would bind 0.0.0.0.
HOST=

# ── Dev-only scripts (scripts/dev/*, never read by the server) ──────────────
ELEVENLABS_API_KEY=
PIXABAY_API_KEY=

# ── Legacy ──────────────────────────────────────────────────────────────────
# Present in older .env files; no code reads this today. Safe to leave empty.
PGS_API_KEY=
