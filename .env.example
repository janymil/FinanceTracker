# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database
# Production database (Neon). Used by server/db.ts when NODE_ENV=production and by
# `npm run db:clean-users:prod`.
DATABASE_URL_PROD=postgresql://user:password@ep-xxx.neon.tech/neondb

# Clerk Authentication
# IMPORTANT: CLERK_SECRET_KEY must be a SECRET key (sk_test_... / sk_live_...).
# Using the publishable key here makes every authenticated API request return 401.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Production Clerk secret key (sk_live_...), used by `npm run auth:clean-users:prod`.
CLERK_SECRET_KEY_PROD=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# OpenAI
OPENAI_API_KEY=sk-proj-...

# AI routing (lib/aiProvider.ts)
# gpt-6-luna is the default model for every task. Fallbacks: DeepSeek, then Groq.
# reasoning effort: none | minimal | low | medium  (none = cheapest/fastest)
AI_REASONING_EFFORT=none
AI_REQUEST_TIMEOUT_MS=90000

# AI Processor Service (optional, external-services/ai-processor)
# Disabled by default - the app calls OpenAI/DeepSeek/Groq directly.
# Enable once the service is deployed at 162.35.25.125 / ai-processor.formatika.dev.
AI_PROCESSOR_ENABLED=false
AI_PROCESSOR_URL=https://ai-processor.formatika.dev
AI_PROCESSOR_API_KEY=
AI_PROCESSOR_TIMEOUT_MS=20000
AI_PROCESSOR_COOLDOWN_MS=300000

# PDF Report Processor (standalone app on pdf-processor.formatika.dev)
# Used by /api/export-pdf, /api/export (format: pdf) and /api/generate-trends-pdf.
PDF_SERVICE_URL=https://pdf-processor.formatika.dev
PDF_API_KEY=
PDF_SERVICE_TIMEOUT_MS=60000

# Mistral / Groq (voice, OCR, AI fallbacks)
MISTRAL_API_KEY=
GROQ_API_KEY=
# Mistral OCR model (mistral-ocr-latest, mistral-ocr-4-1, ...)
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Cloudflare R2 (receipts, exports, backups) - falls back to local disk when empty
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Admin Panel
ADMIN_PASSWORD=your_admin_password

# Session Secret
SESSION_SECRET=your_session_secret

# Stripe
# Both `price_…` ids and `prod_…` product ids are accepted. Product ids are
# resolved to the product's default_price via the Stripe API (cached in memory).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STANDARD_MONTHLY_PRICE_ID=price_...
STRIPE_STANDARD_YEARLY_PRICE_ID=price_...
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...

# Google Cloud Vision (for OCR)
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_PRIVATE_KEY_ID=your_key_id
GOOGLE_CLOUD_PRIVATE_KEY=your_private_key
GOOGLE_CLOUD_CLIENT_EMAIL=your_service_account_email
GOOGLE_CLOUD_CLIENT_ID=your_client_id
GOOGLE_CLOUD_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_CLOUD_TOKEN_URI=https://oauth2.googleapis.com/token

# Bunny.net Cloud Storage
BUNNY_STORAGE_ZONE=your_storage_zone
BUNNY_ACCESS_KEY=your_access_key
BUNNY_STORAGE_PASSWORD=your_storage_password

# ── Observability ───────────────────────────────────────────────────────────
# There is no Sentry in this project. All error reporting is the in-house
# Error Guard (see /sk/admin-watch and the ERROR_GUARD_* block below).
# Release identifier shown on every problem card (optional but recommended).
VITE_APP_RELEASE=

# ── Synthetic monitoring (scripts/healthcheck.ts) ───────────────────────────
# GET /api/health (shallow) or /api/health/deep (also pings the database with SELECT 1).
HEALTHCHECK_URL=https://kaptia.app
HEALTHCHECK_MAX_LATENCY_MS=2000
# Escape hatch for E2E only. Ignored when NODE_ENV=production.
DISABLE_COUNTRY_BLOCKING=0

# ── E2E (Playwright) ────────────────────────────────────────────────────────
# Opt-in: without E2E_ENABLED=1 every spec skips with an explicit reason.
E2E_ENABLED=0
E2E_BASE_URL=http://localhost:5000
E2E_LOCALE=sk
# Local stub that replaces pdf-processor.formatika.dev during E2E.
E2E_PDF_STUB_PORT=4010
# Let Playwright start the app itself (uses the vars above + .env).
E2E_MANAGED_SERVER=0

# ── Integration tests (Neon branch, never production) ───────────────────────
DATABASE_URL_TEST=

# ── Error Guard (blueprint 07, /sk/admin-watch) ─────────────────────────────
# All optional: the guard runs with sane defaults and degrades to "no AI" without keys.
# How often the in-memory buffer is written to Postgres (default 10 s).
ERROR_GUARD_FLUSH_MS=10000
# Per-IP requests per minute on the public ingest endpoint (default 240).
ERROR_GUARD_INTAKE_PER_MINUTE=240
# AI explanations per UTC day (default 25). Set to 0 to never call AI.
ERROR_GUARD_AI_BUDGET=25
# Hard off switch: `off` disables AI explanations, the problem list keeps working.
# ERROR_GUARD_AI=off
ERROR_GUARD_AI_TIMEOUT_MS=20000
# After a failed triage call, stop asking for 5 minutes (never blocks a request).
ERROR_GUARD_AI_COOLDOWN_MS=300000
# `off` disables server-side reporting (reportSwallowed / reportInvariant) entirely.
# ERROR_GUARD_SERVER=off
# Triage goes to AI_PROCESSOR_URL + /error-triage (see the AI processor block above).
# E-mail alerts: comma-separated recipients. Empty = no alerts, the screen still works.
ERROR_GUARD_ALERT_EMAIL=
# Base URL used in the alert e-mail link (defaults to APP_URL or https://kaptia.app).
ERROR_GUARD_URL=
# Alert throttling: at most one e-mail per 10 min, 8 per day, once per problem per 6 h.
ERROR_GUARD_ALERT_MIN_GAP_MS=600000
ERROR_GUARD_ALERT_MAX_PER_DAY=8

# ── Error Guard (browser) ───────────────────────────────────────────────────
# `off` disables client-side capture entirely (capture is on by default).
# VITE_ERROR_GUARD=off