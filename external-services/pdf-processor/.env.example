# Standalone PDF report service — pdf-processor.formatika.dev
# Copy to .env and adjust before starting the service.

NODE_ENV=production

# Caddy terminates TLS and proxies to this loopback port.
HOST=127.0.0.1
PORT=8082

# URL encoded in the report QR code.
APP_URL=https://kaptia.app

# Comma-separated list of accepted API keys (x-api-key or Authorization: Bearer).
# Leave empty ONLY for local development — /generate-pdf would then be public.
PDF_API_KEY=

# Optional: directory with the bundled DejaVu fonts (defaults to ./assets).
# PDF_ASSETS_DIR=
