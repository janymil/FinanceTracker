node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# Security - Never commit service account files or environment secrets
.env
.env.*
!.env.example
service-account.json
*-service-account.json
google-cloud-credentials.json
gcp-*.json

# Local data backups (may contain personal data)
backups/

# Scratch files that must never be committed (one of them held a real admin session cookie)
cookies*.txt
admin_cookies.txt
headers.txt
response*.txt
response*.pdf

# Media & temporary scratch footage
temp-*
*.mov
videos-raw/

# graphify generated artifacts (knowledge graph output)
graphify-out/

# Landing videos/posters are served from Cloudflare R2 (media.kaptia.app)
# Intentionally untracked - see client/src/components/landing/LandingVideo.tsx
client/public/videos/*.mp4
client/public/videos/*.webm
client/public/videos/*.webp

# Playwright
test-results/
playwright-report/

# Playwright auth state (contains a live session cookie, never commit)
tests/e2e/.auth/

# Tesseract language data (downloaded on demand, never committed)
eng.traineddata

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Database dumps, user uploads and local tool settings never belong in git
prod_*.txt
dev_*.txt
uploads/
attached_assets/
.claude/settings.local.json
server.log
*.log
Screenshot *.png
kaptia-app-analysis.pdf

# The AI gateway is its own repository (github.com/janymil/ai-processor)
/ai-processor/
