{
  "include": [
    "client/src/**/*",
    "shared/**/*",
    "server/**/*",
    "tests/**/*",
    "playwright.config.ts",
    "scripts/healthcheck.ts",
    "scripts/sentry-smoke.ts",
    "scripts/capture-ai-fixture.ts",
    "scripts/benchmark-ocr.ts",
    "scripts/error-guard-smoke.ts",
    "scripts/error-guard-prune.ts",
    "scripts/uptime-check.ts",
    "scripts/db-schema-drift.ts",
    "scripts/check-readiness.ts",
    "scripts/restore-verify.ts",
    "scripts/load-test-import.ts",
    "scripts/seed-demo-data.ts"
  ],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
