{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./client/.env)",
      "Read(./client/.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/service-account*.json)",
      "Read(./**/gcp-*.json)",
      "Read(/etc/kaptia/**)",
      "Read(/run/secrets/**)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.local",
        ".env.development",
        ".env.production",
        "client/.env",
        "client/.env.local",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/service-account*.json",
        "**/gcp-*.json",
        "/etc/kaptia",
        "/run/secrets"
      ]
    }
  }
}
